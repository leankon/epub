# PDF Workstation configuration. Copy to .env (scripts/dev.sh does this automatically and
# replaces the change-me placeholders with random local passwords). Never commit .env.

# --- Network binding (loopback only by default) ---
PDFWS_HOST=127.0.0.1
PDFWS_BACKEND_PORT=8765
PDFWS_FRONTEND_PORT=3000
# Must be true to bind PDFWS_HOST to a non-loopback interface. Not recommended.
PDFWS_ALLOW_NETWORK=false
# Extra "host:port" values accepted in the Host header (comma separated), e.g. for a LAN name.
PDFWS_EXTRA_ALLOWED_HOSTS=

# --- Storage ---
PDFWS_DATA_DIR=./data

# --- PostgreSQL ---
# native: private cluster in data/postgres (needs PostgreSQL server binaries)
# docker: `db` service from docker-compose.yml; external: you manage the server
PDFWS_PG_MODE=native
PDFWS_PG_PORT=54329
PDFWS_DB_NAME=pdfws
PDFWS_DB_OWNER_ROLE=pdfws_owner
PDFWS_DB_APP_ROLE=pdfws_app
POSTGRES_OWNER_PASSWORD=change-me-owner
POSTGRES_APP_PASSWORD=change-me-app
# Owner: runs migrations. App: runtime role without UPDATE/DELETE on the audit log.
DATABASE_ADMIN_URL=postgresql+psycopg://pdfws_owner:change-me-owner@127.0.0.1:54329/pdfws
DATABASE_URL=postgresql+psycopg://pdfws_app:change-me-app@127.0.0.1:54329/pdfws

# --- Limits ---
PDFWS_MAX_UPLOAD_MB=500
PDFWS_MAX_PAGES=3000
PDFWS_MAX_CONCURRENT_JOBS=2
PDFWS_MAX_QUEUED_JOBS=200
PDFWS_JOB_TIMEOUT_SECONDS=14400
PDFWS_SUBPROCESS_TIMEOUT_SECONDS=600
PDFWS_SUBPROCESS_MEMORY_MB=4096
PDFWS_TEMP_MAX_AGE_HOURS=24

# --- OCR / conversion tools ---
PDFWS_OCR_DPI=300
PDFWS_OCR_LANGUAGES=spa+eng
PDFWS_TESSERACT_CMD=tesseract
PDFWS_SOFFICE_CMD=soffice
PDFWS_JAVA_CMD=java
PDFWS_EPUBCHECK_JAR=./tools/epubcheck/epubcheck.jar
